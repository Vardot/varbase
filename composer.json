{
  "name": "vardot/varbase",
  "description": "Varbase: The Ultimate Drupal CMS Starter Kit (Bootstrap Ready) | by Vardot",
  "type": "drupal-profile",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Vardot",
      "homepage": "https://www.drupal.org/vardot",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "http://drupal.org/project/issues/varbase",
    "source": "http://cgit.drupalcode.org/varbase"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "replace": {
    "drupal/statistics": "*",
    "twbs/bootstrap": "*",
    "jquery/fancytree": "*",
    "fancytree/fancytree": "*",
    "npm-asset/ckeditor5": "*",
    "npm-asset/ckeditor5-dll-inline": "*",
    "npm-asset/ckeditor5-core": "*",
    "npm-asset/ckeditor5-engine":"*",
    "npm-asset/ckeditor5-ui": "*",
    "npm-asset/ckeditor5-utils": "*",
    "npm-asset/ckeditor5-widget": "*",
    "npm-asset/ckeditor--ckeditor5": "*",
    "npm-asset/ckeditor--ckeditor5-dll-inline": "*",
    "npm-asset/ckeditor--ckeditor5-core": "*",
    "npm-asset/ckeditor--ckeditor5-engine":"*",
    "npm-asset/ckeditor--ckeditor5-ui": "*",
    "npm-asset/ckeditor--ckeditor5-utils": "*",
    "npm-asset/ckeditor--ckeditor5-widget": "*",
    "npm-asset/lodash-es": "*",
    "npm-asset/lodash.debounce": "*",
    "npm-asset/lodash.throttle": "*",
    "npm-asset/nouislider": "*",
    "npm-asset/rtseo.js": "*",
    "bower-asset/jquery": "*",
    "bower-asset/jquery-ui": "*"
  },
  "require": {
    "drupal/varbase_core": "9.1.x-dev",
    "drupal/varbase_api": "9.1.x-dev",
    "drupal/varbase_media": "9.1.x-dev",
    "drupal/varbase_editor": "9.2.x-dev",
    "drupal/varbase_landing": "9.1.x-dev",
    "drupal/varbase_layout_builder": "10.0.x-dev",
    "drupal/varbase_bootstrap_paragraphs": "9.1.x-dev",
    "drupal/varbase_heroslider_media": "9.1.x-dev",
    "drupal/varbase_carousels": "9.1.x-dev",
    "drupal/varbase_blog": "9.1.x-dev",
    "drupal/varbase_search": "9.1.x-dev",
    "drupal/varbase_seo": "9.1.x-dev",
    "drupal/varbase_auth": "9.1.x-dev",
    "drupal/varbase_total_control": "9.1.x-dev",
    "drupal/varbase_styleguide": "9.1.x-dev",
    "drupal/varbase_email": "9.1.x-dev",
    "drupal/varbase_workflow": "2.1.x-dev",
    "drupal/vartheme_bs4": "9.0.x-dev",
    "drupal/vartheme_claro": "3.0.x-dev",
    "bower-asset/objectfitpolyfill": "~2",
    "bower-asset/chartjs": "~4",
    "bower-asset/c3": "0.7.*",
    "bower-asset/d3": "~5",
    "bower-asset/jqueryui-touch-punch": "dev-master",
    "npm-asset/masonry-layout": "~4",
    "npm-asset/imagesloaded": "~4",
    "npm-asset/dropzone": "~5",
    "npm-asset/blazy": "~1",
    "npm-asset/slick-carousel": "~1",
    "npm-asset/ace-builds": "~1",
    "npm-asset/swagger-ui-dist": "~3",
    "npm-asset/ckeditor--ckeditor5-media-embed": "*"
  },
  "autoload": {
    "psr-4": {
      "Varbase\\composer\\": "src/composer"
    }
  }
}
