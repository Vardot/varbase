{
  "name": "vardot/varbase",
  "description": "Varbase: The Ultimate Drupal CMS Starter Kit (Bootstrap Ready) | by Vardot",
  "type": "drupal-profile",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Vardot",
      "homepage": "https://www.drupal.org/vardot",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "http://drupal.org/project/issues/varbase",
    "source": "http://cgit.drupalcode.org/varbase"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "assets": {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  },
  "replace": {
    "drupal/statistics": "*",
    "jquery/fancytree": "*",
    "fancytree/fancytree": "*",
    "drupal/openapi_rest": "*",
    "drupal/ckeditor_media_embed": "*",
    "drupal/media_bulk_upload": "*",
    "drupal/config_perms": "*",
    "npm-asset/ckeditor5": "*",
    "npm-asset/ckeditor5-dll-inline": "*",
    "npm-asset/ckeditor5-core": "*",
    "npm-asset/ckeditor5-engine":"*",
    "npm-asset/ckeditor5-ui": "*",
    "npm-asset/ckeditor5-utils": "*",
    "npm-asset/ckeditor5-widget": "*",
    "npm-asset/ckeditor--ckeditor5": "*",
    "npm-asset/ckeditor--ckeditor5-dll-inline": "*",
    "npm-asset/ckeditor--ckeditor5-core": "*",
    "npm-asset/ckeditor--ckeditor5-engine":"*",
    "npm-asset/ckeditor--ckeditor5-ui": "*",
    "npm-asset/ckeditor--ckeditor5-utils": "*",
    "npm-asset/ckeditor--ckeditor5-widget": "*",
    "npm-asset/lodash-es": "*",
    "npm-asset/lodash.debounce": "*",
    "npm-asset/lodash.throttle": "*",
    "npm-asset/nouislider": "*",
    "npm-asset/rtseo.js": "*",
    "bower-asset/jquery": "*",
    "bower-asset/jquery-ui": "*"
  },
  "require": {
    "drupal/varbase_core": "10.1.x-dev",
    "drupal/varbase_components": "3.0.x-dev",
    "drupal/varbase_api": "10.1.x-dev",
    "drupal/varbase_ai": "2.0.x-dev",
    "drupal/varbase_media": "10.1.x-dev",
    "drupal/varbase_editor": "10.1.x-dev",
    "drupal/varbase_landing": "10.1.x-dev",
    "drupal/varbase_layout_builder": "10.2.x-dev",
    "drupal/varbase_bootstrap_paragraphs": "10.1.x-dev",
    "drupal/varbase_heroslider": "1.1.x-dev",
    "drupal/varbase_carousels": "10.1.x-dev",
    "drupal/varbase_blog": "10.1.x-dev",
    "drupal/varbase_search": "10.1.x-dev",
    "drupal/varbase_seo": "10.1.x-dev",
    "drupal/varbase_auth": "10.1.x-dev",
    "drupal/varbase_dashboards": "1.1.x-dev",
    "drupal/varbase_email": "10.1.x-dev",
    "drupal/varbase_workflow": "3.1.x-dev",
    "drupal/varbase_demo": "1.1.x-dev",
    "drupal/vartheme_bs5": "4.0.x-dev",
    "bower-asset/jqueryui-touch-punch": "dev-master",
    "npm-asset/dropzone": "~5",
    "npm-asset/blazy": "~1",
    "npm-asset/slick-carousel": "~1",
    "npm-asset/ace-builds": "~1",
    "npm-asset/swagger-ui-dist": "~3",
    "npm-asset/northernco--ckeditor5-anchor-drupal": "^0.5.0",
    "npm-asset/ckeditor--ckeditor5-media-embed": "*",
    "npm-asset/jquery.fancytree": "~2"
  },
  "autoload": {
    "psr-4": {
      "Varbase\\composer\\": "src/composer"
    }
  }
}